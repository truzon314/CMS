DATABASE_URL=postgresql+asyncpg://truzon_cms_app:CHANGE_ME@localhost:5432/truzon_cms
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3001,http://localhost:3000
# Base URL of the CMS admin frontend, used to build links in transactional
# emails (user invites, password resets). Set to the real admin domain in prod.
ADMIN_FRONTEND_URL=http://localhost:3001
MEDIA_STORAGE_DIR=./media_storage
PUBLIC_MEDIA_BASE_URL=http://localhost:8000
MAX_IMAGE_UPLOAD_MB=25
MAX_VIDEO_UPLOAD_MB=200
# Leave the R2_* vars unset to use local-disk storage (dev/tests default).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
